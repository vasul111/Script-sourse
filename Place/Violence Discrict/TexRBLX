-- ============================================================================
-- Helper Functions & Clean Up Handlers
-- ============================================================================

local function safeDisconnect(conn)
    if conn and typeof(conn) == "RBXScriptConnection" then
        conn:Disconnect()
    end
end

local function unloadScript()
    if isUnloaded then return end
    isUnloaded = true

    -- Disconnect all active connections
    for _, conn in ipairs(connections) do
        safeDisconnect(conn)
    end
    table.clear(connections)

    safeDisconnect(noclipLoop)
    safeDisconnect(CFloop)
    safeDisconnect(VflyLoop)
    safeDisconnect(speedBoostLoop)
    safeDisconnect(speedAttributeLoop)
    safeDisconnect(jumpPowerConnection)
    safeDisconnect(infJumpConnection)
    safeDisconnect(insideAmbienceConn)
    safeDisconnect(outsideAmbienceConn)
    safeDisconnect(clockTimeConn)
    safeDisconnect(saturationConn)
    safeDisconnect(tintColorConn)

    -- Reset original properties
    if originalProperties.DevEnableMouseLock ~= nil then
        LocalPlayer.DevEnableMouseLock = originalProperties.DevEnableMouseLock
    end

    if originalProperties.Ambient ~= nil then
        Lighting.Ambient = originalProperties.Ambient
    end
    if originalProperties.OutdoorAmbient ~= nil then
        Lighting.OutdoorAmbient = originalProperties.OutdoorAmbient
    end
    if originalProperties.ClockTime ~= nil then
        Lighting.ClockTime = originalProperties.ClockTime
    end

    if colorCorrectionEffect then
        colorCorrectionEffect:Destroy()
    end
    if customSkyboxInstance then
        customSkyboxInstance:Destroy()
    end

    if currentTrack then currentTrack:Stop() end
    if currentSound then currentSound:Destroy() end

    -- Destroy UI
    Library:Unload()
end

