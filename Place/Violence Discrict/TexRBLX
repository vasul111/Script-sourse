local function applySkybox(skyName)
    local preset = skyboxes[skyName]
    if not preset then return end
    if not customSkyboxInstance then
        customSkyboxInstance = Instance.new("Sky")
        customSkyboxInstance.Name = "Obsidian_CustomSky"
        customSkyboxInstance.CelestialBodiesShown = true
        customSkyboxInstance.Parent = Lighting
    end
    for prop, val in pairs(preset) do
        customSkyboxInstance[prop] = val
    end
end

