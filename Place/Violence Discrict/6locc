function createSliderFloat(parentSection, sliderTitle, minValue, maxValue, defaultValue, callbackFn, customColor)
    local activeColor = customColor or UI.Accent
    local minVal = minValue or 0
    local maxVal = maxValue or 1
    local curVal = math.clamp(defaultValue or minVal, minVal, maxVal)
    
    local sliderFrame = Instance.new("Frame")
    sliderFrame.Size = UDim2.new(1, 0, 0, 42)
