-- ============================================================================
-- [Aimbot Execution & Camera Smoothing Loop]
-- ============================================================================

local function updateAimbot(deltaTime)
    Camera = Workspace.CurrentCamera or Camera
    if not Camera then return end

    local mousePos = getMouseLocation()

    -- Update FOV Circle
    if FOVCircle then
        local radius = Settings.FOV.Radius
        if Settings.FOV.DynamicRadius and Camera.FieldOfView > 0 then
            radius = (Settings.FOV.Radius / Camera.FieldOfView) * 70
        end
        FOVCircle.Visible = Settings.FOV.Enabled
        FOVCircle.Position = mousePos
        FOVCircle.Radius = radius
        FOVCircle.Color = State.IsAiming and Settings.FOV.LockedColor or Settings.FOV.Color
    end

    -- Acquire or Validate Target
    local target, targetPart, predictedPos = getClosestTarget()
    State.CurrentTarget = target
    State.TargetPart = targetPart
    State.TargetPredictedPos = predictedPos

    -- Update UI & Trajectory Visuals
    if target and targetPart and predictedPos then
        local screenTargetPos, onScreen = worldToScreen(predictedPos)
        
        if onScreen and Settings.Trajectory.Enabled then
            -- 1. Target Indicator Dot
            GuiLayer.TargetDot.Visible = true
            GuiLayer.TargetDot.Position = UDim2.new(0, screenTargetPos.X, 0, screenTargetPos.Y)
            GuiLayer.TargetDot.BackgroundColor3 = Settings.Visuals.HighlightColor

            -- 2. Target Info Text
            if Settings.Visuals.ShowTargetInfo then
                local humanoid = target.Character:FindFirstChildOfClass("Humanoid")
                local hp = humanoid and math.floor(humanoid.Health) or 0
                local dist = math.floor((targetPart.Position - Camera.CFrame.Position).Magnitude)
                GuiLayer.InfoLabel.Visible = true
                GuiLayer.InfoLabel.Position = UDim2.new(0, screenTargetPos.X, 0, screenTargetPos.Y + 14)
                GuiLayer.InfoLabel.Text = string.format("%s | %d HP | %d studs", target.DisplayName or target.Name, hp, dist)
            else
                GuiLayer.InfoLabel.Visible = false
            end

            -- 3. Snapline or Path2D Trajectory Arc
            local startPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            if Settings.Trajectory.SnaplineOrigin == "Center" then
                startPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            end

            -- Snapline straight line rendering
            if Settings.Trajectory.ShowSnapline then
                local delta = screenTargetPos - startPos
                local length = delta.Magnitude
                local center = (startPos + screenTargetPos) / 2
                local angle = math.deg(math.atan2(delta.Y, delta.X))

                GuiLayer.Snapline.Visible = true
                GuiLayer.Snapline.Size = UDim2.new(0, length, 0, Settings.Trajectory.Thickness)
                GuiLayer.Snapline.Position = UDim2.new(0, center.X, 0, center.Y)
                GuiLayer.Snapline.Rotation = angle
            else
                GuiLayer.Snapline.Visible = false
            end

            -- Path2D Bézier curve rendering (if available in engine)
            if GuiLayer.Path2D and Settings.Trajectory.UsePath2D then
                pcall(function()
                    -- Create quadratic Bézier curve control points
                    local midPoint = (startPos + screenTargetPos) / 2
                    -- Arc peak height based on gravity and distance
                    local arcHeight = math.clamp((screenTargetPos - startPos).Magnitude * 0.15, 20, 150)
                    local controlPoint = Vector2.new(midPoint.X, midPoint.Y - arcHeight)

                    local cp1 = Path2DControlPoint.new(UDim2.new(0, startPos.X, 0, startPos.Y))
                    local cp2 = Path2DControlPoint.new(UDim2.new(0, controlPoint.X, 0, controlPoint.Y))
                    local cp3 = Path2DControlPoint.new(UDim2.new(0, screenTargetPos.X, 0, screenTargetPos.Y))

                    GuiLayer.Path2D:SetControlPoints({cp1, cp2, cp3})
                    GuiLayer.Path2D.Visible = true
                end)
            end
        else
            GuiLayer.TargetDot.Visible = false
            GuiLayer.InfoLabel.Visible = false
            GuiLayer.Snapline.Visible = false
            if GuiLayer.Path2D then GuiLayer.Path2D.Visible = false end
        end
    else
        GuiLayer.TargetDot.Visible = false
        GuiLayer.InfoLabel.Visible = false
        GuiLayer.Snapline.Visible = false
        if GuiLayer.Path2D then GuiLayer.Path2D.Visible = false end
    end

    -- Perform Aim Movement if Active
    if State.IsAiming and target and targetPart and predictedPos then
        if Settings.Aimbot.AimMode == "CameraLock" then
            local currentCFrame = Camera.CFrame
            local targetDirection = (predictedPos - currentCFrame.Position).Unit
            local targetCFrame = CFrame.lookAt(currentCFrame.Position, currentCFrame.Position + targetDirection)

            local smoothness = math.clamp(Settings.Aimbot.Smoothness, 0.01, 1)
            -- DeltaTime adjusted lerp factor
            local lerpFactor = 1 - math.exp(-30 * (1 - smoothness + 0.05) * deltaTime)
            Camera.CFrame = currentCFrame:Lerp(targetCFrame, math.clamp(lerpFactor, 0.01, 1))

        elseif Settings.Aimbot.AimMode == "Mouse" then
            local screenPos, onScreen = worldToScreen(predictedPos)
            if onScreen and mousemoverel then
                local deltaX = (screenPos.X - mousePos.X) * (1 - Settings.Aimbot.Smoothness) * Settings.Aimbot.Sensitivity
                local deltaY = (screenPos.Y - mousePos.Y) * (1 - Settings.Aimbot.Smoothness) * Settings.Aimbot.Sensitivity
                mousemoverel(deltaX, deltaY)
            end
        end
    end
end

-- ============================================================================
-- [Silent Aim Metamethod Hooking]
-- ============================================================================

local function setupSilentAimHooks()
    if not hookmetamethod or not getnamecallmethod then return end

    local originalNamecall
    originalNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        if Settings.Aimbot.Enabled and Settings.Aimbot.AimMode == "SilentAim" then
            if method == "Raycast" and self == Workspace then
                if State.CurrentTarget and State.TargetPredictedPos then
                    local origin = args[1]
                    if origin and typeof(origin) == "Vector3" then
                        local customDir = (State.TargetPredictedPos - origin).Unit * 1000
                        args[2] = customDir
                        return originalNamecall(self, table.unpack(args))
                    end
                end
            elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" then
                if State.CurrentTarget and State.TargetPredictedPos then
                    local ray = args[1]
                    if ray and typeof(ray) == "Ray" then
                        local customDir = (State.TargetPredictedPos - ray.Origin).Unit * 1000
                        args[1] = Ray.new(ray.Origin, customDir)
                        return originalNamecall(self, table.unpack(args))
                    end
                end
            end
        end

        return originalNamecall(self, ...)
    end))

    table.insert(State.OriginalMetamethods, { Object = game, Method = "__namecall", Function = originalNamecall })
end

-- ============================================================================
-- [Input Handling & Keybind Listener]
-- ============================================================================

local function isKeybindActive(input, settingKeybind)
    if typeof(settingKeybind) == "EnumItem" then
        if input.UserInputType == settingKeybind or input.KeyCode == settingKeybind then
            return true
        end
    end
    return false
end

addConnection(UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if isKeybindActive(input, Settings.Aimbot.Keybind) then
        if Settings.Aimbot.TriggerMode == "Hold" then
            State.IsAiming = true
        elseif Settings.Aimbot.TriggerMode == "Toggle" then
            State.IsAiming = not State.IsAiming
        end
    end
end))

addConnection(UserInputService.InputEnded:Connect(function(input)
    if isKeybindActive(input, Settings.Aimbot.Keybind) then
        if Settings.Aimbot.TriggerMode == "Hold" then
            State.IsAiming = false
        end
    end
end))

-- Render loop for frame updates
addConnection(RunService.RenderStepped:Connect(updateAimbot))

-- Initialize Silent Aim Hooks
pcall(setupSilentAimHooks)

-- ============================================================================
-- [Cleanup & Disposal Handler]
-- ============================================================================

local function cleanup()
    State.IsAiming = false

    -- Disconnect all event listeners
    for _, conn in ipairs(State.Connections) do
        safeDisconnect(conn)
    end
    table.clear(State.Connections)

    -- Remove Drawing Objects
    for _, drawing in ipairs(State.DrawingObjects) do
        pcall(function()
            if drawing and drawing.Remove then
                drawing:Remove()
            end
        end)
    end
    table.clear(State.DrawingObjects)

    -- Destroy UI Containers
    for _, gui in ipairs(State.GuiObjects) do
        pcall(function()
            if gui and gui.Destroy then
                gui:Destroy()
            end
        end)
    end
    table.clear(State.GuiObjects)

    _G.Aimbot_Cleanup = nil
end

_G.Aimbot_Cleanup = cleanup
