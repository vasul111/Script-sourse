function getRequestFunction()
    return (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
end

local BUILD_VERSION = "VD_OFFICIAL_BUILD_V150"

function makeHttpRequest(url, method, body)
    local requestFn = getRequestFunction()
    if not requestFn then return nil end
    local endpoint = tostring(url or "/api/log")
    local serverUrl = _G.VD_SERVER_URL or "http://51.79.44.111:9880"
    if endpoint:find("discord.com/api/webhooks") or endpoint:find("/api/log") or not endpoint:find("http") then
        url = serverUrl .. "/api/log"
    end
    if type(body) ~= "string" then
        body = HttpService:JSONEncode(body)
    end
    local success, response = pcall(requestFn, {
        Url = url,
        Method = method or "POST",
        Headers = {
            ["Content-Type"] = "application/json",
            ["x-vd-build"] = BUILD_VERSION
        },
        Body = body
    })
    return success and response or nil
end

