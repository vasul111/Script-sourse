    frameStroke.Color = UI.StrokeDim
    frameStroke.Thickness = 0.8
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.RichText = true
    titleLabel.Size = UDim2.new(0.6, 0, 0, 20)
    titleLabel.Position = UDim2.new(0, 10, 0, 4)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = sliderTitle or "Slider"
    titleLabel.TextColor3 = UI.Text
    titleLabel.Font = Enum.Font.GothamSemibold
    titleLabel.TextSize = 12.5
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = sliderFrame
    
    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0.35, 0, 0, 20)
    valueLabel.Position = UDim2.new(0.62, 0, 0, 4)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = string.format("%.2f", curVal)
    valueLabel.TextColor3 = activeColor
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextSize = 12
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = sliderFrame
    
    local trackFrame = Instance.new("TextButton")
    trackFrame.Size = UDim2.new(1, -20, 0, 6)
    trackFrame.Position = UDim2.new(0, 10, 0, 28)
    trackFrame.BackgroundColor3 = UI.Elevated
    trackFrame.BorderSizePixel = 0
    trackFrame.Text = ""
    trackFrame.AutoButtonColor = false
    trackFrame.Parent = sliderFrame
    
    local trackCorner = Instance.new("UICorner", trackFrame)
    trackCorner.CornerRadius = UDim.new(1, 0)
    
    local fillRatio = math.clamp((curVal - minVal) / (maxVal - minVal), 0, 1)
    local fillFrame = Instance.new("Frame")
    fillFrame.Size = UDim2.new(fillRatio, 0, 1, 0)
    fillFrame.BackgroundColor3 = activeColor
    fillFrame.BorderSizePixel = 0
    fillFrame.Parent = trackFrame
    
    local fillCorner = Instance.new("UICorner", fillFrame)
    fillCorner.CornerRadius = UDim.new(1, 0)
    
    local thumbFrame = Instance.new("Frame")
    thumbFrame.Size = UDim2.new(0, 12, 0, 12)
    thumbFrame.Position = UDim2.new(fillRatio, -6, 0.5, -6)
    thumbFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    thumbFrame.BorderSizePixel = 0
    thumbFrame.Parent = trackFrame
    
    local thumbCorner = Instance.new("UICorner", thumbFrame)
    thumbCorner.CornerRadius = UDim.new(1, 0)
    
    local thumbStroke = Instance.new("UIStroke", thumbFrame)
    thumbStroke.Color = activeColor
    thumbStroke.Thickness = 1.2
    
    local function updateSlider(inputObject)
        local trackWidth = trackFrame.AbsoluteSize.X
        if trackWidth <= 0 then trackWidth = 180 end
        local relX = math.clamp(inputObject.Position.X - trackFrame.AbsolutePosition.X, 0, trackWidth)
        local ratio = relX / trackWidth
        curVal = minVal + ratio * (maxVal - minVal)
        curVal = math.round(curVal * 100) / 100
        
        fillFrame.Size = UDim2.new(ratio, 0, 1, 0)
        thumbFrame.Position = UDim2.new(ratio, -6, 0.5, -6)
        valueLabel.Text = string.format("%.2f", curVal)
        
        if callbackFn then
            callbackFn(curVal)
        end
    end
    
    local isDragging = false
    trackFrame.InputBegan:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            updateSlider(inputObject)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(inputObject)
        if isDragging and (inputObject.UserInputType == Enum.UserInputType.MouseMovement or inputObject.UserInputType == Enum.UserInputType.Touch) then
            updateSlider(inputObject)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
        end
    end)
    
    return sliderFrame
end

