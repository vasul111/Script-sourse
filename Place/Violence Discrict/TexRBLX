-- [Noclip Implementation]
local function enableNoclip()
    Noclipping = true
    if noclipLoop then noclipLoop:Disconnect() end
    noclipLoop = RunService.Heartbeat:Connect(function()
        if not Noclipping or isUnloaded then
            if noclipLoop then noclipLoop:Disconnect() end
            return
        end
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end)
    table.insert(connections, noclipLoop)
end

local function disableNoclip()
    Noclipping = false
    if noclipLoop then
        noclipLoop:Disconnect()
        noclipLoop = nil
    end
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end

-- [CFrame Fly Implementation]
local function getFlyMoveVector()
    local moveVec = Vector3.new(0, 0, 0)
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then
        moveVec = moveVec + Vector3.new(0, 0, -1)
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then
        moveVec = moveVec + Vector3.new(0, 0, 1)
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then
        moveVec = moveVec + Vector3.new(-1, 0, 0)
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then
        moveVec = moveVec + Vector3.new(1, 0, 0)
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        moveVec = moveVec + Vector3.new(0, 1, 0)
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        moveVec = moveVec + Vector3.new(0, -1, 0)
    end
    if moveVec.Magnitude > 0 then
        moveVec = moveVec.Unit
    end
    return moveVec
end

local function enableCFrameFly()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head")
    if humanoid then humanoid.PlatformStand = true end
    if head then head.Anchored = true end

    if CFloop then CFloop:Disconnect() end
    CFloop = RunService.Heartbeat:Connect(function(delta)
        if flyMode ~= "CFrame" or not Toggles.fly.Value or isUnloaded then
            if CFloop then CFloop:Disconnect() end
            return
        end
        local character = LocalPlayer.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        local camera = workspace.CurrentCamera
        if rootPart and camera then
            local moveDir = getFlyMoveVector()
            local speed = CFspeed
            local camCF = camera.CFrame
            local moveWorld = camCF:VectorToWorldSpace(moveDir)
            rootPart.CFrame = rootPart.CFrame + (moveWorld * (speed * delta))
            rootPart.Velocity = Vector3.new(0, 0, 0)
        end
    end)
    table.insert(connections, CFloop)
end

local function disableCFrameFly()
    if CFloop then
        CFloop:Disconnect()
        CFloop = nil
    end
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local head = char:FindFirstChild("Head")
        if humanoid then humanoid.PlatformStand = false end
        if head then head.Anchored = false end
    end
end

-- [Velocity Fly Implementation]
local function enableVelocityFly()
    local char = LocalPlayer.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    if VflyLoop then VflyLoop:Disconnect() end
    VflyLoop = RunService.Heartbeat:Connect(function()
        if flyMode ~= "Velocity" or not Toggles.fly.Value or isUnloaded then
            if VflyLoop then VflyLoop:Disconnect() end
            return
        end
        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local camera = workspace.CurrentCamera
        if hrp and camera then
            local moveDir = getFlyMoveVector()
            local camCF = camera.CFrame
            local moveWorld = camCF:VectorToWorldSpace(moveDir)
            hrp.Velocity = moveWorld * VflySpeed
        end
    end)
    table.insert(connections, VflyLoop)
end

local function disableVelocityFly()
    if VflyLoop then
        VflyLoop:Disconnect()
        VflyLoop = nil
    end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Velocity = Vector3.new(0, 0, 0)
    end
end

-- [Speed Boost Implementation]
local function enableSpeedBoost()
    if speedMethod == "Attribute" then
        if speedAttributeLoop then speedAttributeLoop:Disconnect() end
        speedAttributeLoop = RunService.Heartbeat:Connect(function()
            if not isSpeedBoostActive or isUnloaded then
                if speedAttributeLoop then speedAttributeLoop:Disconnect() end
                return
            end
            local char = LocalPlayer.Character
            if char then
                pcall(function()
                    char:SetAttribute("speedboost", speedBoostMultiplier)
                end)
            end
        end)
        table.insert(connections, speedAttributeLoop)
    elseif speedMethod == "TP" then
        if speedBoostLoop then speedBoostLoop:Disconnect() end
        speedBoostLoop = RunService.Heartbeat:Connect(function()
            if not isSpeedBoostActive or isUnloaded then
                if speedBoostLoop then speedBoostLoop:Disconnect() end
                return
            end
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.MoveDirection.Magnitude > 0 then
                pcall(function()
                    char:TranslateBy(hum.MoveDirection * (speedBoostMultiplier / 10))
                end)
            end
        end)
        table.insert(connections, speedBoostLoop)
    end
end

local function disableSpeedBoost()
    if speedAttributeLoop then
        speedAttributeLoop:Disconnect()
        speedAttributeLoop = nil
    end
    if speedBoostLoop then
        speedBoostLoop:Disconnect()
        speedBoostLoop = nil
    end
    local char = LocalPlayer.Character
    if char then
        pcall(function()
            char:SetAttribute("speedboost", 0)
        end)
    end
end

-- [Walk Fling Implementation]
local function enableWalkFling()
    walkflinging = true
    task.spawn(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildWhichIsA("Humanoid")
        if hum then
            hum.Died:Connect(function()
                walkflinging = false
            end)
        end

        while walkflinging and not isUnloaded do
            RunService.Heartbeat:Wait()
            local character = LocalPlayer.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if root then
                local currentVel = root.Velocity
                root.Velocity = currentVel * flingStrength + Vector3.new(0, flingStrength, 0)
                RunService.RenderStepped:Wait()
                root.Velocity = currentVel
            end
        end
    end)
end

local function disableWalkFling()
    walkflinging = false
end

-- [Fling All Implementation]
local function flingAllPlayers()
    task.spawn(function()
        while flingAllToggleActive and not isUnloaded do
            RunService.Heartbeat:Wait()
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and not flingWhitelist[player.Name] then
                    local targetChar = player.Character
                    local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                    local myChar = LocalPlayer.Character
                    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    if targetHrp and myHrp and targetHrp.Position.Y > workspace.FallenPartsDestroyHeight then
                        local startTime = tick()
                        while (tick() - startTime) < 0.5 and flingAllToggleActive and not isUnloaded do
                            RunService.Heartbeat:Wait()
                            if targetHrp and myHrp then
                                myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 1)
                            else
                                break
                            end
                        end
                    end
                end
            end
        end
    end)
end

