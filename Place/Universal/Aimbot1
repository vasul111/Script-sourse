-- Check if player is alive
local function isPlayerAlive(player)
    if not player or not player.Character then return false end
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health > 0
end

-- Get Team
local function isTeammate(player)
    if not Settings.Aimbot.TeamCheck then return false end
    if player == LocalPlayer then return true end
    if player.Team and LocalPlayer.Team then
        return player.Team == LocalPlayer.Team
    end
    if player.TeamColor and LocalPlayer.TeamColor then
        return player.TeamColor == LocalPlayer.TeamColor
    end
    return false
end

-- Get Roblox Friend
local function isFriend(player)
    if not Settings.Aimbot.FriendCheck then return false end
    local success, result = pcall(function()
        return LocalPlayer:IsFriendsWith(player.UserId)
    end)
    return success and result
end

-- Raycast Visibility Check
local function isPartVisible(origin, part, targetCharacter)
    if not Settings.Aimbot.WallCheck then return true end
    if not part or not origin then return false end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.IgnoreWater = true
    
    local ignoreList = { LocalPlayer.Character, Camera }
    if targetCharacter then
        -- Also ignore non-collidable or transparent accessories of target
    end
    rayParams.FilterDescendantsInstances = ignoreList

    local direction = (part.Position - origin)
    local rayResult = Workspace:Raycast(origin, direction, rayParams)

    if not rayResult then
        return true
    end

    return rayResult.Instance:IsDescendantOf(targetCharacter)
end

-- Get Network Ping
local function getPing()
    if not Settings.Prediction.PingCompensation then return 0 end
    local success, pingVal = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    end)
    return success and pingVal or 0.05
end

-- Convert 3D World Position to 2D Screen Position
local function worldToScreen(worldPos)
    local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen, screenPos.Z
end

-- Get Mouse 2D Screen Location
local function getMouseLocation()
    return UserInputService:GetMouseLocation()
end

-- ============================================================================
-- [Ballistics & Lead Prediction Engine]
-- ============================================================================

local function calculateTrajectory(origin, targetPos, targetVelocity, projectileSpeed, gravity)
    if not Settings.Prediction.Enabled or projectileSpeed <= 0 then
        return targetPos, 0
    end

    local ping = getPing()
    local distance = (targetPos - origin).Magnitude
    local timeToHit = (distance / projectileSpeed) + ping

    -- Velocity prediction with multiplier
    local predictedVelocity = targetVelocity * Settings.Prediction.PredictionMultiplier
    local predictedPos = targetPos + (predictedVelocity * timeToHit)

    -- Gravity drop compensation
    if gravity > 0 then
        local drop = 0.5 * gravity * (timeToHit ^ 2)
        predictedPos = predictedPos + Vector3.new(0, drop, 0)
    end

    return predictedPos, timeToHit
end

-- ============================================================================
-- [Target Selection Engine]
-- ============================================================================

local function getBestTargetPart(character)
    local aimPartSetting = Settings.Aimbot.AimPart
    if aimPartSetting ~= "Closest" then
        return character:FindFirstChild(aimPartSetting)
    end

    local mousePos = getMouseLocation()
    local bestPart = nil
    local shortestDist = math.huge

    for _, partName in ipairs(Settings.Aimbot.HitParts) do
        local part = character:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            local screenPos, onScreen = worldToScreen(part.Position)
            if onScreen then
                local dist = (screenPos - mousePos).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    bestPart = part
                end
            end
        end
    end

    return bestPart or character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
end

local function getClosestTarget()
    local mousePos = getMouseLocation()
    local bestTarget = nil
    local bestTargetPart = nil
    local bestPredictedPos = nil
    local shortestDistance = math.huge

    local fovRadius = Settings.FOV.Radius
    if Settings.FOV.DynamicRadius and Camera.FieldOfView > 0 then
        fovRadius = (Settings.FOV.Radius / Camera.FieldOfView) * 70
    end

    local cameraOrigin = Camera.CFrame.Position

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isPlayerAlive(player) and not isTeammate(player) and not isFriend(player) then
            local character = player.Character
            local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
            
            if rootPart then
                local distFromCamera = (rootPart.Position - cameraOrigin).Magnitude
                if distFromCamera <= Settings.Aimbot.MaxDistance then
                    local targetPart = getBestTargetPart(character)
                    if targetPart then
                        local partPos = targetPart.Position
                        local targetVel = rootPart.AssemblyLinearVelocity or rootPart.Velocity or Vector3.zero
                        
                        -- Predict hit position
                        local predictedPos = partPos
                        if Settings.Prediction.Enabled then
                            predictedPos = calculateTrajectory(
                                cameraOrigin,
                                partPos,
                                targetVel,
                                Settings.Prediction.ProjectileSpeed,
                                Settings.Prediction.ProjectileGravity
                            )
                        end

                        local screenPos, onScreen = worldToScreen(predictedPos)
                        if onScreen then
                            local screenDist = (screenPos - mousePos).Magnitude
                            if screenDist <= fovRadius and screenDist < shortestDistance then
                                if isPartVisible(cameraOrigin, targetPart, character) then
                                    shortestDistance = screenDist
                                    bestTarget = player
                                    bestTargetPart = targetPart
                                    bestPredictedPos = predictedPos
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return bestTarget, bestTargetPart, bestPredictedPos
end

