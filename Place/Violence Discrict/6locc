function showNotification(notifTitle, notifMessage, notifType, duration)
    local pGui = guiParent or (LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui"))
    if not pGui then return end
    if not notificationGui or not notificationGui.Parent then
        notificationGui = Instance.new("ScreenGui")
        notificationGui.Name = "VD_Notifications"
        notificationGui.ResetOnSpawn = false
        notificationGui.Parent = pGui
    end
    
    local card = Instance.new("Frame")
    card.Size = UDim2.new(0, 260, 0, 56)
    card.Position = UDim2.new(1, 20, 0, 20 + (#notificationList * 64))
    card.BackgroundColor3 = UI.Card
    card.BorderSizePixel = 0
    card.Parent = notificationGui
    
    local corner = Instance.new("UICorner", card)
    corner.CornerRadius = UDim.new(0, UI.CardRadius)
    
    local stroke = Instance.new("UIStroke", card)
    stroke.Color = (notifType == "warning" and UI.AccentRed) or (notifType == "info" and UI.AccentCyan) or UI.Accent
    stroke.Thickness = 1
    
    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, -16, 0, 20)
    titleLbl.Position = UDim2.new(0, 10, 0, 6)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = notifTitle or "Notification"
    titleLbl.TextColor3 = UI.Text
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 13
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Parent = card
    
    local msgLbl = Instance.new("TextLabel")
    msgLbl.Size = UDim2.new(1, -16, 0, 24)
    msgLbl.Position = UDim2.new(0, 10, 0, 26)
    msgLbl.BackgroundTransparency = 1
    msgLbl.Text = notifMessage or ""
    msgLbl.TextColor3 = UI.TextSub
    msgLbl.Font = Enum.Font.Gotham
    msgLbl.TextSize = 11.5
    msgLbl.TextXAlignment = Enum.TextXAlignment.Left
    msgLbl.TextWrapped = true
    msgLbl.Parent = card
    
    table.insert(notificationList, card)
    TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(1, -280, 0, card.Position.Y.Offset)}):Play()
    
    task.delay(duration or 3.5, function()
        if card and card.Parent then
            local tw = TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(1, 20, 0, card.Position.Y.Offset)})
            tw:Play()
            tw.Completed:Connect(function()
                card:Destroy()
                for i, c in ipairs(notificationList) do
                    if c == card then
                        table.remove(notificationList, i)
                        break
                    end
                end
            end)
        end
    end)
end

function clearAllNotifications()
    for _, card in ipairs(notificationList) do
        if card and card.Parent then
            card:Destroy()
        end
    end
    notificationList = {}
end

-- [Config Serialization & File I/O]
local CONFIG_FILE = "VD_Config.json"

local function serializeTable(tbl)
    local serialized = {}
    for k, v in pairs(tbl) do
        if typeof(v) == "Color3" then
            serialized[k] = {__type = "Color3", r = v.R, g = v.G, b = v.B}
        elseif type(v) == "table" then
            serialized[k] = serializeTable(v)
        else
            serialized[k] = v
        end
    end
    return serialized
end

local function deserializeTable(target, src)
    if type(src) ~= "table" or type(target) ~= "table" then return end
    for k, v in pairs(src) do
        if type(v) == "table" and v.__type == "Color3" then
            target[k] = Color3.new(v.r, v.g, v.b)
        elseif type(v) == "table" then
            if type(target[k]) ~= "table" then target[k] = {} end
            deserializeTable(target[k], v)
        else
            target[k] = v
        end
    end
end

local function saveConfigs()
    if not writefile then return end
    pcall(function()
        local data = {
            activeProfile = ConfigProfiles.activeProfile or "Default",
            profiles = {}
        }
        for profName, profTbl in pairs(ConfigProfiles.profiles) do
            data.profiles[profName] = serializeTable(profTbl)
        end
        writefile(CONFIG_FILE, HttpService:JSONEncode(data))
    end)
end

local function loadConfigs()
    if not readfile or not isfile or not isfile(CONFIG_FILE) then return end
    pcall(function()
        local raw = readfile(CONFIG_FILE)
        local decoded = HttpService:JSONDecode(raw)
        if type(decoded) == "table" then
            if decoded.activeProfile then
                ConfigProfiles.activeProfile = decoded.activeProfile
            end
            if type(decoded.profiles) == "table" then
                for profName, profData in pairs(decoded.profiles) do
                    ConfigProfiles.profiles[profName] = {}
                    deserializeTable(ConfigProfiles.profiles[profName], profData)
                end
            end
        end
    end)
end


