                Parent = SliderFrame
            })

            local ValueLbl = Create("TextLabel", {
                Text = tostring(value),
                Font = Enum.Font.Gotham,
                TextSize = 12,
                TextColor3 = ThemeManager:GetColor("SubText"),
                TextXAlignment = Enum.TextXAlignment.Right,
                Position = UDim2.new(1, -50, 0, 6),
