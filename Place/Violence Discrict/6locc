local function fetchCustomAsset(url, fileName, defaultAsset)
    local canFile = writefile and (readfile and (isfile and (getcustomasset or getsynasset)))
    local customAssetFn = getcustomasset or getsynasset
    if not canFile or not customAssetFn then
        return defaultAsset
    end
    if not isfile(fileName) then
        local success, result = pcall(function()
            local req = getRequestFunction()
            if req then
                local res = req({
                    Url = url,
                    Method = "GET",
                    Timeout = 3
                })
                if res and res.StatusCode == 200 then
                    return res.Body
                end
            end
            return game:HttpGet(url)
        end)
        if success and result and #result > 0 then
            pcall(writefile, fileName, result)
        else
            return defaultAsset
        end
    end
    local ok, asset = pcall(customAssetFn, fileName)
    return ok and asset or defaultAsset
end

