                BackgroundColor3 = ThemeManager:GetColor("Stroke"),
                BorderSizePixel = 0,
                Parent = SliderFrame
            }, {
                Create("UICorner", { CornerRadius = UDim.new(1, 0) })
            })

            local SliderFill = Create("Frame", {
                Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
                BackgroundColor3 = ThemeManager:GetColor("Accent"),
                BorderSizePixel = 0,
                Parent = SliderBar
            }, {
                Create("UICorner", { CornerRadius = UDim.new(1, 0) })
            })
            ThemeManager:Register(SliderFill, "BackgroundColor3", "Accent")

            local sliding = false
            local function UpdateSlide(input)
                local pos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
                local exactVal = min + (max - min) * pos
                local snappedVal = math.floor(exactVal / increment + 0.5) * increment
                value = math.clamp(snappedVal, min, max)

                ValueLbl.Text = tostring(value)
                SliderFill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
                pcall(callback, value)
            end

            SliderBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    UpdateSlide(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateSlide(input)
                end
            end)

            return {
                Set = function(val)
                    value = math.clamp(val, min, max)
                    ValueLbl.Text = tostring(value)
                    SliderFill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
                    pcall(callback, value)
                end,
                Value = value
            }
        end
