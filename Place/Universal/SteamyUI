                    OptBtn.MouseButton1Click:Connect(function()
                        selected = opt
                        TitleLbl.Text = dropName .. ": " .. tostring(selected)
                        open = false
                        ArrowLbl.Text = "˅"
                        TweenService:Create(DropFrame, TweenInfo.new(0.2), { Size = UDim2.new(1, 0, 0, 36) }):Play()
                        RefreshOptions()
                        pcall(callback, selected)
                    end)
                end
            end

            DropHeader.MouseButton1Click:Connect(function()
                open = not open
                ArrowLbl.Text = open and "˄" or "˅"
                local targetHeight = open and (40 + #optionsList * 28) or 36
                TweenService:Create(DropFrame, TweenInfo.new(0.2), { Size = UDim2.new(1, 0, 0, targetHeight) }):Play()
            end)

            RefreshOptions()

            return {
                Set = function(val)
                    selected = val
                    TitleLbl.Text = dropName .. ": " .. tostring(selected)
                    RefreshOptions()
                    pcall(callback, selected)
                end,
                Refresh = function(newOpts)
                    optionsList = newOpts or {}
                    OptionContainer.Size = UDim2.new(1, -10, 0, #optionsList * 28)
                    RefreshOptions()
                end,
                Value = selected
            }
        end
