-- Dance Animations List
local danceAnimations = {}
local animFolder = ReplicatedStorage:FindFirstChild("Animations") or workspace:FindFirstChild("Animations")
if animFolder then
    for _, child in pairs(animFolder:GetChildren()) do
        if child:IsA("Folder") or child:IsA("Animation") then
            table.insert(danceAnimations, child.Name)
        end
    end
end

if #danceAnimations > 0 then
    CharacterGroup:AddDropdown("danceDropdown", {
        Values = danceAnimations,
        Default = 1,
        Multi = false,
        Text = "Custom Dance / Animation",
        Callback = function(Value)
            if currentTrack then currentTrack:Stop() end
            if currentSound then currentSound:Destroy() end

            local animObj = animFolder:FindFirstChild(Value)
            if animObj then
                local animId = animObj:GetAttribute("animationid") or (animObj:IsA("Animation") and animObj.AnimationId)
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum and animId then
                    local anim = Instance.new("Animation")
                    anim.AnimationId = animId
                    currentTrack = hum:LoadAnimation(anim)
                    currentTrack:Play()

                    local song = animObj:FindFirstChild("Song")
                    if song and song:IsA("Sound") then
                        currentSound = song:Clone()
                        currentSound.Parent = char.PrimaryPart or char:FindFirstChild("Head")
                        currentSound:Play()
                    end
                end
            end
        end
    })

    CharacterGroup:AddButton({
        Text = "Stop Dance",
        Func = function()
            if currentTrack then currentTrack:Stop() end
            if currentSound then currentSound:Destroy() end
        end
    })
end

