local HttpService = game:GetService("HttpService")
local CONFIG_FILE = "VD_Config.json"

local function serializeTable(tbl)
    local serialized = {}
    for k, v in pairs(tbl) do
        if typeof(v) == "Color3" then
            serialized[k] = {__type = "Color3", r = v.R, g = v.G, b = v.B}
        elseif type(v) == "table" then
            serialized[k] = serializeTable(v)
        else
            serialized[k] = v
        end
    end
    return serialized
end

local function deserializeTable(target, src)
    if type(src) ~= "table" or type(target) ~= "table" then return end
    for k, v in pairs(src) do
        if type(v) == "table" and v.__type == "Color3" then
            target[k] = Color3.new(v.r, v.g, v.b)
        elseif type(v) == "table" then
            if type(target[k]) ~= "table" then target[k] = {} end
            deserializeTable(target[k], v)
        else
            target[k] = v
        end
    end
end

local function saveConfigs()
    if not writefile then return end
    pcall(function()
        local data = {
            activeProfile = ConfigProfiles.activeProfile or "Default",
            profiles = {}
        }
        for profName, profTbl in pairs(ConfigProfiles.profiles) do
            data.profiles[profName] = serializeTable(profTbl)
        end
        writefile(CONFIG_FILE, HttpService:JSONEncode(data))
    end)
end

local function loadConfigs()
    if not readfile or not isfile or not isfile(CONFIG_FILE) then return end
    pcall(function()
        local raw = readfile(CONFIG_FILE)
        local decoded = HttpService:JSONDecode(raw)
        if type(decoded) == "table" then
            if decoded.activeProfile then
                ConfigProfiles.activeProfile = decoded.activeProfile
            end
            if type(decoded.profiles) == "table" then
                for profName, profData in pairs(decoded.profiles) do
                    ConfigProfiles.profiles[profName] = {}
                    deserializeTable(ConfigProfiles.profiles[profName], profData)
                end
            end
        end
    end)
end

