-- Setup ESP Overrides & Weapon Detection
ESP.Overrides.GetWeapon = function(player)
    if not player.Character or not player.Team then return nil end
    if player.Team.Name == "Survivors" then
        local model = player.Character:FindFirstChildOfClass("Model")
        if model then
            return model.Name
        end
    elseif player.Team.Name == "Killer" then
        local weapon = player.Character:FindFirstChild("Weapon")
        if weapon then
            local part = weapon:FindFirstChildWhichIsA("BasePart") or weapon:FindFirstChildWhichIsA("MeshPart")
            if part then
                return weapon.Name
            end
        end
    end
    return nil
end

