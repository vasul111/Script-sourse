function showStartupCapabilityReport()
    local unavailableList = getUnavailableFeatures()
    if #unavailableList == 0 then
        showNotification("Compatibility Check", "All features supported on " .. identifyExecutor() .. ".", "success")
        return
    end
    local formattedFeatures = table.concat(unavailableList, ", ")
    if #formattedFeatures > 90 then
        formattedFeatures = formattedFeatures:sub(1, 87) .. "..."
    end
    showNotification("Compatibility Warning", #unavailableList .. " feature(s) limited on " .. identifyExecutor() .. ": " .. formattedFeatures, "warning", 8)
end

